# Public subdomain for the app (must already be on your Cloudflare account).
# NOTE: set this SAME value as the domain in deploy/authelia/configuration.yml
# (it is used there for the Authelia cookie + access control rule).
DOMAIN=tracker.example.com

# Flask API signing key. Generate with: openssl rand -base64 48
SECRET_KEY=

# Authelia secrets. Generate each with: openssl rand -base64 48
AUTHELIA_SESSION_SECRET=
AUTHELIA_RESET_PASSWORD_JWT_SECRET=
# Storage encryption key (must be 20+ characters).
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Cloudflare Tunnel token (Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> ... -> Copy token)
CLOUDFLARE_TUNNEL_TOKEN=
